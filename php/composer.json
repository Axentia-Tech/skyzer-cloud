{
  "name": "skyzer-cloud/php",
  "description": "Skyzer Cloud - Modern Minecraft Hosting Billing Platform",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "vlucas/phpdotenv": "^5.5",
    "firebase/php-jwt": "^6.9",
    "guzzlehttp/guzzle": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "SkyzerCloud\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

