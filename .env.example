# Database
DATABASE_URL=postgresql://skyzer:password@postgres:5432/skyzer_cloud

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Pterodactyl
PTERODACTYL_URL=http://pterodactyl:8080
PTERODACTYL_API_KEY=your-pterodactyl-api-key

# Tebex
TEBEX_SECRET=your-tebex-webhook-secret
TEBEX_CHECKOUT_BASE_URL=https://checkout.tebex.io

# API
API_PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Email (SendGrid, Mailgun, SES, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@skyzer.cloud

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn

# AWS S3 (Backups)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
S3_BUCKET=skyzer-backups
